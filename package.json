{
  "name": "nhb-ball-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "server": "node --env-file-if-exists=.env server/server.js",
    "client": "vite",
    "dev": "concurrently -k -n \"API,WEB\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "start": "node --env-file-if-exists=.env server/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  }
}
