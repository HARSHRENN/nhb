# Server runtime (requires Node 22.9+)
PORT=3001
HOST=127.0.0.1
SITE_URL=https://nhbball.com
# Required in production; use a long random secret, never a VITE_ variable.
ADMIN_TOKEN=
# Vite development proxy only. Change both PORT and this if 3001 is occupied.
API_PROXY_TARGET=http://127.0.0.1:3001
# Public GA4 measurement ID. Leave blank until the NHB property is ready.
VITE_GA_MEASUREMENT_ID=
# Optional absolute directory for persistent database and uploaded files.
# DATA_DIR=/path/to/persistent/nhb-data
